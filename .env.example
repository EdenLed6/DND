# ------- D&D Campaign Manager — environment -------
# Copy to .env and fill in for production.

# Database. Dev default is SQLite (prisma/schema.prisma uses file:./dev.db).
# For production use PostgreSQL, e.g. from Neon/Supabase/Railway:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Node environment.
NODE_ENV=production

# Port the server listens on.
PORT=3000

# REQUIRED in production: comma-separated list of allowed origins for the
# realtime (Socket.IO) connection. Set this to your real domain(s).
# Without it, cross-origin socket connections are blocked (secure default).
ALLOWED_ORIGIN=https://yourdomain.com

# Public base URL of the app — used to build links in emails and OAuth redirects.
# REQUIRED in production (the app refuses to build reset/verify/OAuth links from
# the request Host header, to prevent host-header injection). Dev falls back to
# the request host. Also ensure the app runs behind a trusted proxy that sets
# X-Forwarded-For / X-Real-IP (Railway/Render/Cloudflare) so rate limiting works.
APP_URL=https://yourdomain.com

# ------- Google sign-in (optional) -------
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://yourdomain.com/api/auth/google/callback
# The "Continue with Google" button only appears when GOOGLE_CLIENT_ID is set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------- Email (verification + password reset) -------
# Provider-agnostic — configured in src/lib/email/mailer.ts. Default: Resend.
# Get a key at https://resend.com (free tier). Without a key, emails are logged
# to the server console (dev mode).
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="D&D Campaign Manager <noreply@yourdomain.com>"
