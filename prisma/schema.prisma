// D&D 5e Campaign Manager — data model
// See docs/02-DATA-MODEL.md. SQLite has no enums -> String with documented values.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ============================================================
// Users & Auth
// ============================================================
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  displayName   String
  passwordHash  String? // null for Google-only accounts
  googleId      String?   @unique // linked Google account
  avatarUrl     String? // profile picture (e.g. from Google)
  emailVerified DateTime? // null = not verified (soft reminder)
  createdAt     DateTime  @default(now())

  campaignsOwned Campaign[]          @relation("DM")
  memberships    CampaignMember[]
  characters     Character[]
  sessions       Session[]
  authTokens     AuthToken[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Single-use tokens for email verification and password reset.
model AuthToken {
  id        String   @id @default(cuid())
  token     String   @unique // random, high-entropy
  type      String // "verify" | "reset"
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, type])
}

// ============================================================
// Campaigns
// ============================================================
model Campaign {
  id          String   @id @default(cuid())
  name        String
  description String?
  dmId        String
  dm          User     @relation("DM", fields: [dmId], references: [id], onDelete: Cascade)
  partyGoldCp Int      @default(0) // party purse stored in copper
  xpMode      String   @default("xp") // "xp" | "milestone"
  inviteCode  String   @unique
  createdAt   DateTime @default(now())

  settingsJson String @default("{}") // rule toggles: crit rules, enemy HP visibility, dice visibility, rest rules...

  members    CampaignMember[]
  characters Character[]
  encounters Encounter[]
  maps       GameMap[]
  loot       LootItem[]
  notes      CampaignNote[]
  sessions   GameSession[]
  npcs       Npc[]
  quests     Quest[]
  dmNotes    DmNote[]
  partyItems PartyItem[]
  auditLogs  AuditLog[]
  homebrewMonsters HomebrewMonster[]
  invites    CampaignInvite[]
  worldPages WorldPage[]
  homebrewSpells HomebrewSpell[]
  homebrewItems  HomebrewItem[]
}

// Email invitation — joining a campaign requires BOTH a pending invite for the
// user's (verified) email AND the campaign invite code. Two independent layers.
model CampaignInvite {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email      String // invited address, stored lowercased
  invitedBy  String // DM userId
  status     String   @default("pending") // pending | accepted | revoked
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@unique([campaignId, email])
  @@index([email])
}

// ============================================================
// World layer (SPEC-DM §5, §10, §11, §14) + conditions & audit
// ============================================================

// Applied condition / ongoing effect (docs/design-system/CONDITIONS-COMPONENT.he.md).
// Target is a combatant (in an encounter) or a character (out of combat).
model AppliedCondition {
  id              String    @id @default(cuid())
  encounterId     String?
  combatantId     String?
  characterId     String?
  name            String
  icon            String?
  category        String    @default("condition") // condition|dot|buff|debuff|injury|exhaustion|custom
  severity        String?
  sourceText      String?
  durationRounds  Int?
  remainingRounds Int?
  saveAbility     String?   // str|dex|con|int|wis|cha
  saveDc          Int?
  stacks          Int       @default(1)
  visibility      String    @default("public") // public | dm
  automationJson  String    @default("{}") // {startTurnDamage:"1d6", damageType:"fire", endTurnSave:true, autoExpire:"end-of-turn"}
  notes           String?
  createdAt       DateTime  @default(now())

  @@index([encounterId])
  @@index([combatantId])
  @@index([characterId])
}

model HomebrewMonster {
  id            String    @id @default(cuid())
  ownerId       String
  campaignId    String?
  name          String
  statBlockJson String    // same shape the combat engine reads for SRD monsters
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  campaign      Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([campaignId])
}

model GameSession {
  id          String    @id @default(cuid())
  campaignId  String
  number      Int
  title       String    @default("")
  date        DateTime?
  status      String    @default("PLANNED") // PLANNED | LIVE | DONE
  agendaJson  String    @default("[]") // [{title, done, notes}]
  prepNotes   String?
  recapPlayer String?   // player-visible recap
  recapDm     String?   // DM-only recap
  xpAwarded   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model Npc {
  id            String   @id @default(cuid())
  campaignId    String
  name          String
  role          String?
  location      String?
  faction       String?
  attitude      String?  // friendly | neutral | hostile | unknown
  portraitUrl   String?
  publicDesc    String?  // players may see this when revealed
  secretDesc    String?  // DM only, never serialized to players
  statBlockJson String?
  status        String   @default("alive")
  revealed      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model Quest {
  id         String   @id @default(cuid())
  campaignId String
  name       String
  status     String   @default("ACTIVE") // ACTIVE | DONE | FAILED | HIDDEN
  giver      String?
  objective  String?
  stepsJson  String   @default("[]") // [{text, done}]
  rewards    String?
  playerText String?  // player-visible description
  dmNotes    String?  // DM only
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

// DM notes & secrets (SPEC-DM §14) — visibility-controlled campaign notes.
model DmNote {
  id         String   @id @default(cuid())
  campaignId String
  title      String   @default("")
  body       String   @default("")
  category   String   @default("Campaign") // Campaign|Session|NPC|Location|Quest|Encounter|Character|Secret|Handout
  visibility String   @default("dm") // dm | players (revealed)
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

// Shared party inventory (SPEC-DM §11).
model PartyItem {
  id             String   @id @default(cuid())
  campaignId     String
  name           String
  quantity       Int      @default(1)
  notes          String?
  srcEquipmentId String?
  srcMagicItemId String?
  claimedById    String?  // characterId that claimed it
  hidden         Boolean  @default(false) // DM-only until revealed
  createdAt      DateTime @default(now())
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

// Audit log for DM actions (SPEC v2.2 §6).
model AuditLog {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  action     String
  detail     String?
  ts         DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, ts])
}

model CampaignMember {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  role       String   @default("PLAYER") // DM | PLAYER | VIEWER
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
}

model CampaignNote {
  id         String   @id @default(cuid())
  campaignId String
  title      String
  body       String   @default("")
  dmOnly     Boolean  @default(true)
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

// ============================================================
// Characters
// ============================================================
model Character {
  id          String  @id @default(cuid())
  ownerId     String
  campaignId  String?
  name        String
  avatarUrl   String?

  // identity
  raceId      String
  subrace     String?
  background  String?
  alignment   String?
  inspiration Boolean @default(false)

  // ability scores (source of truth, final base incl. racial)
  str Int @default(10)
  dex Int @default(10)
  con Int @default(10)
  int Int @default(10)
  wis Int @default(10)
  cha Int @default(10)

  // progression
  xp Int @default(0)

  // hit points
  maxHpBonus   Int @default(0)
  currentHp    Int @default(0)
  tempHp       Int @default(0)
  hitDiceUsed  Int @default(0)
  deathSuccess Int @default(0)
  deathFail    Int @default(0)

  // combat state
  exhaustion    Int     @default(0)
  conditions    String  @default("[]") // JSON string[]
  concentration String? // spell name

  // manual overrides
  acOverride    Int?
  speedOverride Int?

  // currency (copper base)
  cp Int @default(0)
  sp Int @default(0)
  ep Int @default(0)
  gp Int @default(0)
  pp Int @default(0)

  // roleplay
  personality String?
  ideals      String?
  bonds       String?
  flaws       String?
  backstory   String?
  notes       String?
  appearance      String? // age, height, weight, eyes, hair, skin — free text or JSON
  characteristics String? // background characteristics beyond personality/ideals/bonds/flaws

  // json blobs
  proficienciesJson String @default("{}") // {languages,tools,weapons,armor,skillChoices}
  featuresJson      String @default("[]") // feats & custom features
  spellcastingJson  String @default("{}") // {slotsUsed:{1:0,...}, pactSlotsUsed, ...}
  defensesJson      String @default("{}") // {resistances[],immunities[],vulnerabilities[],conditionImmunities[],speeds:{fly,swim,climb,burrow}}

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  campaign  Campaign?           @relation(fields: [campaignId], references: [id])
  classes   CharacterClass[]
  items     InventoryItem[]
  spells    CharacterSpell[]
  skills    CharacterSkill[]
  resources CharacterResource[]
  tokens    Token[]
  playerNotes CharacterNote[]
  companions  Companion[]
}

// Player notes (SPEC-PLAYER §14): categorized, pinnable, optionally shared
// with the DM. Private notes are never returned to other users.
// Companion / summoned creature sheet (familiar, wild shape, summon, mount).
// A mini stat block owned by a character; statJson holds the full block
// (abilities, ac, speed, senses, actions, traits) in the HomebrewMonster shape.
model Companion {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name        String
  kind        String    @default("summon") // familiar | wildshape | summon | mount | other
  srcMonsterId Int?     // optional SRD monster this was created from
  statJson    String    @default("{}")
  currentHp   Int       @default(1)
  maxHp       Int       @default(1)
  notes       String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([characterId])
}

// DM-authored world/lore pages with per-page visibility (public | dm).
// The World tab renders these as custom tabs the DM creates.
model WorldPage {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title      String
  content    String   @default("")
  visibility String   @default("dm") // public | dm
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([campaignId, sortOrder])
}

// Homebrew spells & items (DM content manager). dataJson mirrors the SRD
// shapes (SrdSpell / SrdEquipment) so pickers can merge them seamlessly.
model HomebrewSpell {
  id         String    @id @default(cuid())
  ownerId    String
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name       String
  dataJson   String    @default("{}")
  createdAt  DateTime  @default(now())

  @@index([ownerId])
  @@index([campaignId])
}

model HomebrewItem {
  id         String    @id @default(cuid())
  ownerId    String
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name       String
  dataJson   String    @default("{}") // {category, costGp, weight, desc, acBonus, damage, ...}
  createdAt  DateTime  @default(now())

  @@index([ownerId])
  @@index([campaignId])
}

// Persistent roll history (character sheet "roll log" + campaign feed source).
model RollLog {
  id          String   @id @default(cuid())
  userId      String
  characterId String?
  campaignId  String?
  label       String   @default("")
  expression  String?
  total       Int
  breakdown   String   @default("")
  visibility  String   @default("public") // public | dm | self
  ts          DateTime @default(now())

  @@index([characterId, ts])
  @@index([campaignId, ts])
}

model CharacterNote {
  id           String    @id @default(cuid())
  characterId  String
  category     String    @default("General") // General|Session|NPCs|Locations|Quests|Secrets|Rules
  title        String    @default("")
  body         String    @default("")
  pinned       Boolean   @default(false)
  sharedWithDm Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId])
}

model CharacterClass {
  id          String    @id @default(cuid())
  characterId String
  classId     String
  subclass    String?
  level       Int       @default(1)
  isPrimary   Boolean   @default(false)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model CharacterSkill {
  id          String    @id @default(cuid())
  characterId String
  skill       String
  proficient  Boolean   @default(false)
  expertise   Boolean   @default(false)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, skill])
}

model CharacterSpell {
  id             String    @id @default(cuid())
  characterId    String
  spellId        String
  prepared       Boolean   @default(false)
  alwaysPrepared Boolean   @default(false)
  source         String?
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, spellId])
}

model CharacterResource {
  id          String    @id @default(cuid())
  characterId String
  name        String
  max         Int       @default(0)
  used        Int       @default(0)
  resetOn     String    @default("LONG") // SHORT | LONG
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

// ============================================================
// Inventory & Loot
// ============================================================
model InventoryItem {
  id             String    @id @default(cuid())
  characterId    String
  srcEquipmentId String?
  srcMagicItemId String?
  name           String
  quantity       Int       @default(1)
  equipped       Boolean   @default(false)
  attuned        Boolean   @default(false)
  location       String    @default("backpack") // equipped | backpack | pocket | storage
  customJson     String? // {acBonus, acBase, addDex, damage, notes, ...} — equip effects
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model LootItem {
  id             String   @id @default(cuid())
  campaignId     String
  name           String
  quantity       Int      @default(1)
  srcMagicItemId String?
  srcEquipmentId String?
  goldValueCp    Int      @default(0)
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

// ============================================================
// Maps & Combat
// ============================================================
model GameMap {
  id         String      @id @default(cuid())
  campaignId String
  name       String
  imageUrl   String
  gridSize   Int         @default(70)
  gridCols   Int         @default(20)
  gridRows   Int         @default(20)
  offsetX    Int         @default(0)
  offsetY    Int         @default(0)
  campaign   Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  encounters Encounter[]
}

model Encounter {
  id         String      @id @default(cuid())
  campaignId String
  mapId      String?
  name       String
  status       String    @default("PLANNING") // PLANNING | ACTIVE | ENDED
  round        Int       @default(0)
  turnIndex    Int       @default(0)
  fogEnabled   Boolean   @default(false)
  revealedCells String   @default("[]") // JSON string[] of "x,y" cells revealed
  createdAt    DateTime  @default(now())
  campaign   Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  map        GameMap?    @relation(fields: [mapId], references: [id])
  combatants Combatant[]
  tokens     Token[]
  log        CombatLog[]
}

model Combatant {
  id            String     @id @default(cuid())
  encounterId   String
  kind          String     // player | monster | npc
  characterId   String?
  monsterId     String?
  name          String
  initiative    Int        @default(0)
  maxHp         Int        @default(1)
  currentHp     Int        @default(1)
  tempHp        Int        @default(0)
  ac            Int        @default(10)
  conditions    String     @default("[]")
  statBlockJson String?
  isVisible     Boolean    @default(true)
  sortOrder     Int        @default(0)
  encounter     Encounter  @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  token         Token?
}

model Token {
  id          String     @id @default(cuid())
  encounterId String
  combatantId String?    @unique
  characterId String?
  label       String
  color       String     @default("#7b1e1e")
  imageUrl    String?
  gridX       Int        @default(0)
  gridY       Int        @default(0)
  sizeSquares Int        @default(1)
  encounter   Encounter  @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  combatant   Combatant? @relation(fields: [combatantId], references: [id], onDelete: Cascade)
  character   Character? @relation(fields: [characterId], references: [id])
}

model CombatLog {
  id          String    @id @default(cuid())
  encounterId String
  ts          DateTime  @default(now())
  actor       String    @default("")
  message     String
  detailJson  String?
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
}

// ============================================================
// SRD reference data (read-only, seeded from data/srd/srd.sqlite)
// ============================================================
model SrdMonster {
  id                  Int     @id
  name                String
  size                String?
  type                String?
  subtype             String?
  alignment           String?
  ac                  Int?
  acType              String?
  hp                  Int?
  hitDice             String?
  speed               String?
  str                 Int?
  dex                 Int?
  con                 Int?
  int                 Int?
  wis                 Int?
  cha                 Int?
  cr                  String?
  xp                  Int?
  senses              String?
  languages           String?
  traits              String?
  actions             String?
  legendaryActions    String?
  reactions           String?
  resistances         String?
  immunities          String?
  vulnerabilities     String?
  conditionImmunities String?
  savingThrows        String?
  skills              String?
  proficiencyBonus    Int?

  @@index([name])
  @@index([cr])
}

model SrdSpell {
  id                  Int      @id
  name                String
  level               Int
  school              String?
  castingTime         String?
  range               String?
  duration            String?
  concentration       Boolean  @default(false)
  ritual              Boolean  @default(false)
  componentsV         Boolean  @default(false)
  componentsS         Boolean  @default(false)
  componentsM         Boolean  @default(false)
  materialDescription String?
  classes             String?
  description         String?
  higherLevel         String?
  damageType          String?
  saveType            String?

  @@index([name])
  @@index([level])
}

model SrdEquipment {
  id                 Int     @id
  name               String
  category           String?
  costGp             Float?
  costUnit           String?
  weight             Float?
  description        String?
  weaponProperties   String?
  damageDice         String?
  damageType         String?
  weaponRange        String?
  rangeNormal        Int?
  rangeLong          Int?
  armorCategory      String?
  acBase             Int?
  acDexBonus         Boolean?
  acMaxBonus         Int?
  stealthDisadvantage Boolean?
  strMinimum         Int?

  @@index([name])
  @@index([category])
}

model SrdMagicItem {
  id                    Int     @id
  name                  String
  rarity                String?
  type                  String?
  requiresAttunement    Boolean @default(false)
  attunementDescription String?
  description           String?

  @@index([name])
}

model SrdClass {
  id                  Int     @id
  name                String
  hitDie              Int?
  savingThrows        String?
  proficiencies       String?
  spellcastingAbility String?
  features            String?
  subclasses          String?

  @@index([name])
}

model SrdRace {
  id             Int     @id
  name           String
  speed          Int?
  size           String?
  abilityBonuses String?
  traits         String?
  languages      String?
  subraces       String?

  @@index([name])
}

model SrdCondition {
  id          Int    @id
  name        String
  description String?
}

model SrdRule {
  id          Int     @id
  name        String
  section     String?
  description String?
}

model SrdRollableTable {
  id          Int     @id
  name        String
  category    String?
  description String?
  dieType     String?
  entries     String?
}

model SrdBackground {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  skills      String? // JSON string[]
  tools       String?
  languages   String?
  featureName String?
  featureDesc String?
  startGp     Int     @default(0)
  equipment   String?
}
